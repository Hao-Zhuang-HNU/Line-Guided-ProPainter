{
    "seed": 2023,
    "save_dir": "experiments_model/",
    "train_data_loader": {
        "name": "custom_list",
        "use_list": true,
        "video_list": "./data_list/ScannetPP_imgs_train_156618.txt",
        "mask_list": "./data_list/irregular_mask_40_50.txt",
        "line_list": "./data_list/ScannetPP_pkls_train_156618.txt",
        "flow_list": "",
        "w": 432,
        "h": 240,
        "num_local_frames": 5,
        "num_ref_frames": 2,
        "load_flow": 0,
        "line_width": 1,
        "line_swap_xy": true,
        "line_invert_y": true,
        "mask_match_mode": "frame_index",
        "flow_root": "unused_when_load_flow_is_0"
    },
    "losses": {
        "hole_weight": 1,
        "valid_weight": 1,
        "flow_weight": 1,
        "adversarial_weight": 0.0,
        "GAN_LOSS": "hinge",
        "perceptual_weight": 0,
        "line_weighted_weight": 1.0,
        "line_loss_alpha": 3.0,
        "sobel_weight": 0.05,
        "sobel_line_alpha": 2.0
    },
    "model": {
        "net": "propainter",
        "no_dis": 1,
        "load_d": 0,
        "interp_mode": "nearest"
    },
    "trainer": {
        "version": "trainer",
        "type": "Adam",
        "beta1": 0,
        "beta2": 0.99,
        "lr": 5e-05,
        "batch_size": 1,
        "num_workers": 0,
        "num_prefetch_queue": 1,
        "log_freq": 10,
        "save_freq": 1000,
        "iterations": 2000,
        "scheduler": {
            "type": "MultiStepLR",
            "milestones": [
                1500
            ],
            "gamma": 0.1
        },
        "gen_path": "weights/ProPainter.pth"
    }
}